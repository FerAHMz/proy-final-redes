#!/bin/bash
# Servidor web de la intranet de RRHH (Data Center): Nginx que solo responde
# por el nombre ${server_name}; por IP cierra la conexión sin responder.
set -euxo pipefail

# Reintenta hasta que el firewall dé salida a Internet
until dnf install -y nginx; do sleep 10; done

# Contenido de la carpeta web/ del repositorio
install -d -m 755 /usr/share/nginx/rrhh
%{ for name, content in web_files ~}
echo '${content}' | base64 -d > /usr/share/nginx/rrhh/${name}
%{ endfor ~}

# Configuración mínima: sin el sitio por defecto de la distribución,
# sin versión en las respuestas y solo IPv4
cat > /etc/nginx/nginx.conf <<'CONF'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;
include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    include      /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log   /var/log/nginx/access.log;
    sendfile     on;
    server_tokens off;
    include /etc/nginx/conf.d/*.conf;
}
CONF

cat > /etc/nginx/conf.d/rrhh.conf <<'CONF'
# Peticiones por IP o con otro nombre: se cierra la conexión (444)
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${server_name};
    root  /usr/share/nginx/rrhh;
    index index.html;
}
CONF

nginx -t
systemctl enable --now nginx
